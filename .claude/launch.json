{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "native",
      "runtimeExecutable": "cargo",
      "runtimeArgs": ["run", "-p", "huanshu-native"],
      "env": { "HUANSHU_HOME": "E:\\huanshu\\target\\sandbox-home" }
